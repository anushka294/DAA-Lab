#include <stdio.h>
#include <stdlib.h>

#define INF 1e9
#define MAX_N 16  // Suitable for standard competitive programming limits

int n;
int cost[MAX_N][MAX_N];
int dp[1 << MAX_N][MAX_N];

// TSP using dynamic programming with bitmasking
int tsp(int mask, int position) {
    // Base Case: If all cities have been visited
    if (mask == (1 << n) - 1) {
        // Return cost to go back from current position to the starting city (city 0)
        return (cost[position][0] != -1) ? cost[position][0] : INF;
    }

    // Return the result if it is already computed
    if (dp[mask][position] != -1) {
        return dp[mask][position];
    }

    int min_cost = INF;

    // Try visiting all other unvisited cities
    for (int next_city = 0; next_city < n; next_city++) {
        // Check if the city has not been visited yet and a valid path exists
        if ((mask & (1 << next_city)) == 0 && cost[position][next_city] != -1) {
            int new_cost = cost[position][next_city] + tsp(mask | (1 << next_city), next_city);
            if (new_cost < min_cost) {
                min_cost = new_cost;
            }
        }
    }

    return dp[mask][position] = min_cost;
}

int main() {
    // Read the number of cities
    if (scanf("%d", &n) != 1) return 0;

    // Read the cost matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize DP table with -1 (representing uncomputed states)
    for (int i = 0; i < (1 << n); i++) {
        for (int j = 0; j < n; j++) {
            dp[i][j] = -1;
        }
    }

    // Start tour from city 0 (mask = 1 means city 0 is visited)
    int result = tsp(1, 0);

    // If the path is unreachable, print -1 or infinity according to requirements
    if (result >= INF) {
        printf("-1\n");
    } else {
        printf("%d\n", result);
    }

    return 0;
}

